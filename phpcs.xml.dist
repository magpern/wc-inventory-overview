<?xml version="1.0"?>
<ruleset name="WC Inventory Overview">
  <!-- Base ruleset: WordPress-Extra (covers WordPress-Core + WordPress-Docs + WordPress-VIP-Go) -->
  <rule ref="WordPress-Extra">
    <!-- Intentional relaxations for compatibility with existing codebase -->
    <exclude name="WordPress.Security.EscapeOutput.OutputNotEscaped"/>
    <!-- allow some inline conditionals in domain checks -->
    <exclude name="WordPress.PHP.StrictComparisons.LooseComparison"/>
  </rule>

  <!-- WordPress code documentation standards -->
  <rule ref="WordPress-Docs"/>

  <!-- Exclude common non-critical issues found in legacy code -->
  <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
    <exclude-pattern>*/includes/class-wc-inventory-overview-*.php</exclude-pattern>
    <severity>3</severity>
  </rule>

  <!-- Paths to analyze -->
  <file>wc-inventory-overview.php</file>
  <file>includes/</file>
  <file>cli/</file>
  <file>tests/</file>

  <!-- Paths to exclude -->
  <exclude-pattern>/vendor/</exclude-pattern>
  <exclude-pattern>/\.git/</exclude-pattern>
  <exclude-pattern>/.github/</exclude-pattern>
  <exclude-pattern>/node_modules/</exclude-pattern>
  <exclude-pattern>/assets/</exclude-pattern>

  <!-- Report settings -->
  <arg name="report" value="summary"/>
</ruleset>
